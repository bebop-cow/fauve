{
  "manifest_version": 3,
  "name": "Fauve Houdini",
  "version": "0.1.0",
  "description": "Fills data broker opt-out forms locally. You click submit.",
  "permissions": ["storage", "scripting"],
  "host_permissions": [
    "https://www.spokeo.com/*",
    "https://www.instantcheckmate.com/*",
    "https://www.peoplefinders.com/*",
    "https://suppression.peopleconnect.us/*"
  ],
  "action": { "default_popup": "popup.html" }
}